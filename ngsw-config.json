{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/icons/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "fastorder-menu-cache",
      "urls": [
        "/api/menu",
        "/api/categories",
        "/api/products/**",
        "https://images.unsplash.com/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "12h",
        "timeout": "3s",
        "strategy": "freshness"
      }
    },
    {
      "name": "fastorder-orders-cache",
      "urls": [
        "/api/orders/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "2s",
        "strategy": "performance"
      }
    }
  ]
}
